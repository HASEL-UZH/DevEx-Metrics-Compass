# DevEx Metrics Compass — vanity redirects
#
# Lives in the web root (the deployed contents of compass/).
# Apache 2.2+ with mod_rewrite enabled.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # /paper -> the published ACM Queue article
    RewriteRule ^paper$ https://spawn-queue.acm.org/doi/10.1145/3831360 [R=301,L]

    # /paper-stepN -> the matching step of the Compass app
    RewriteRule ^paper-step1$ /?step=explore&role=practitioner&minMentions=25&aiMetric=ai-impact [R=301,L]
    RewriteRule ^paper-step2$ /?step=compare&role=practitioner&leftType=company&leftValue=Google&rightType=company&rightValue=Microsoft&sort=datatype [R=301,L]
    RewriteRule ^paper-step3$ /?shortlist_current=146,140,30,129&shortlist_planned=143,12,18,20,36,150,38,40,65,78&step=nextsteps [R=301,L]

    # Old /seo/ landing pages -> /library/ (renamed 2026-08-19; keeps
    # already-indexed URLs and any shared links working)
    RewriteRule ^seo/(.*)$ /library/$1 [R=301,L]

    # /contribute -> the GitHub repo
    RewriteRule ^contribute$ https://github.com/HASEL-UZH/DevEx-Metrics-Compass [R=301,L]
</IfModule>
